{
  "name": "@robertwtucker/para-vault-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing a PARA-method Obsidian vault as structured tools.",
  "type": "module",
  "bin": {
    "para-vault-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "author": "Robert Tucker <robertwtucker@gmail.com>",
  "homepage": "https://github.com/robertwtucker/para-vault-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertwtucker/para-vault-mcp.git"
  },
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "date-fns": "^4.4.0",
    "globby": "^16.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
